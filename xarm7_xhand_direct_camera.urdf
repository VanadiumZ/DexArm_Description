  <link name="link7">
    <inertial>
      <origin rpy="0 0 0" xyz="0 -0.00677 -0.01098"/>
      <mass value="0.17"/>
      <inertia ixx="9.3e-05" ixy="-0.0" ixz="-0.0" iyy="5.87e-05" iyz="-3.6e-06" izz="0.000132"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="meshes/xarm7_1305/visual/link7.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </visual>

    <!--
      xHand adapter mounting frame.  The adapter STL is in millimetres and
      its plate normal is the mesh +Y axis.  Rotate it +90 deg about X so
      that the plate normal follows the xArm link7 +Z flange axis, then place
      the adapter's mounting centre on the flange.
    -->
    <visual>
      <geometry>
        <!-- Centered on link7 axis; outer radius matches the flange shoulder. -->
        <mesh filename="meshes/adapter/xhand_adapter.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="1.5708 0 0" xyz="0 0 0.0005"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/xarm7_1305/collision/link7.obj"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>

    <collision>
      <geometry>
        <mesh filename="meshes/adapter/xhand_adapter.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="1.5708 0 0" xyz="0 0 0.0005"/>
    </collision>
  </link>
  <joint name="joint7" type="revolute">
