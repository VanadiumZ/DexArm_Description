  <joint name="xhand_mount_joint" type="fixed">
    <!--
      Mount the XHand directly on the centered adapter.  right_hand_link's
      local z=0 face is its mounting face and its body extends toward -z;
      flip that axis so the hand extends away from the adapter (+Z), while
      retaining the source right-hand azimuth (−90° about the flange axis).
      Since this joint is the root of the XHand tree, the transform applies
      to the palm and every finger link together.
    -->
    <parent link="link7" />
    <child link="right_hand_link" />
    <!-- link7 flange (z=0) -> adapter top (z=36.5 mm). -->
    <origin xyz="0 0 0.025" rpy="3.14159265 0 1.5707963" />
  </joint>

  <!-- D405 cameras extracted from xhand_xarm7_with_cameras.d405.mm.stl.
       These origins are expressed in the right_hand_link frame; the D405
       mesh itself is already in the matching local coordinate convention. -->
  <link name="d405_camera_1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.14159265"/>
      <geometry>
        <mesh filename="meshes/camera/d405.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 3.14159265"/>
      <geometry>
        <mesh filename="meshes/camera/d405.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_hand_to_d405_camera_1" type="fixed">
    <!-- Upper/positive-y camera in the extracted assembly. -->
    <origin xyz="0.093977 -0.032933 0.022768"
            rpy="2.618011 -0.462533 -3.141589"/>
    <parent link="right_hand_link"/>
    <child link="d405_camera_1_link"/>
  </joint>

  <link name="d405_camera_2_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.14159265"/>
      <geometry>
        <mesh filename="meshes/camera/d405.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
