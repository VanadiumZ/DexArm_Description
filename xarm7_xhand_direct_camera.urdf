      </geometry>
    </collision>
  </link>
  <joint name="right_hand_to_d405_camera_2" type="fixed">
    <!-- Lower/negative-y camera in the extracted assembly. -->
    <origin xyz="-0.026697 0.060898 -0.010410"
            rpy="3.011275 0.092298 -3.141577"/>
    <parent link="right_hand_link"/>
    <child link="d405_camera_2_link"/>
  </joint>

